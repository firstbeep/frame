{
  "name": "frame-local-storyboard-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Plan product and location shoots with local color concept frames and printable crew boards, powered by QVAC",
  "license": "MIT",
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "verify": "node scripts/verify-sdk.mjs",
    "doctor": "node scripts/doctor.js",
    "setup": "node scripts/setup.js",
    "test": "node scripts/verify-sdk.mjs && node --test test/*.test.js",
    "test:ui": "playwright test",
    "test:startup": "node scripts/test-startup.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@qvac/sdk": "0.19.1",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
